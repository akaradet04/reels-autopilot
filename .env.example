# ─── Vercel (web) → Project Settings → Environment Variables ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
ENCRYPTION_KEY=                 # random string, at least 32 characters. Same value in GitHub. Never change it.
# Optional: lets "post now" start the worker immediately instead of within 30 minutes.
GITHUB_DISPATCH_TOKEN=          # fine-grained token, this repo only, permission Actions: Read and write
GITHUB_REPO=your-name/content-pipeline
GITHUB_REF_NAME=main

# ─── GitHub (worker) → Settings → Secrets and variables → Actions → Secrets ───
# SUPABASE_URL           same as NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_SERVICE_KEY   same as above
# ENCRYPTION_KEY         same as above
#
# Telegram bot token, Facebook App ID/Secret and API keys (Gemini, Pexels, Azure Speech...)
# are entered on the web Settings page, not here.
